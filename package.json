{
  "name": "@qgustavor/las-reader",
  "version": "2.0.0",
  "description": "Read LAS lidar point clouds",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./browser": "./src/browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgustavor/las-reader.git"
  },
  "keywords": [
    "lidar",
    "las",
    "laz",
    "point-cloud",
    "asprs",
    "geospatial"
  ],
  "contributors": [
    "Thornton Mills",
    "Gustavo Rodrigues (http://github.com/qgustavor/)"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/qgustavor/las-reader/issues"
  },
  "homepage": "https://github.com/qgustavor/las-reader#readme",
  "devDependencies": {
    "eslint": "^9.20.0",
    "neostandard": "^0.12.0"
  }
}
